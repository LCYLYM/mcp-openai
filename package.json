{
  "name": "@mzxrai/mcp-openai",
  "version": "0.2.0",
  "description": "Comprehensive MCP server for complete OpenAI API integration with streaming, function calling, embeddings, and more",
  "license": "MIT",
  "author": "mzxrai",
  "homepage": "https://github.com/LCYLYM/mcp-openai",
  "repository": {
    "type": "git",
    "url": "https://github.com/LCYLYM/mcp-openai.git"
  },
  "bugs": "https://github.com/LCYLYM/mcp-openai/issues",
  "type": "module",
  "bin": {
    "mcp-server-openai": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "dev": "tsx watch index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openai",
    "gpt-4o",
    "o1",
    "ai",
    "chat-completions",
    "streaming",
    "function-calling",
    "embeddings",
    "moderation",
    "llm"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.0.1",
    "openai": "^4.76.0"
  },
  "devDependencies": {
    "shx": "^0.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}